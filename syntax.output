Terminals unused in grammar

    "number"
    "zero"


Grammar

    0 $accept: program "End_of_file"

    1 program: header declarations subprograms comp_statement "."

    2 header: "programm" "id" ";"

    3 declarations: constdefs typedefs vardefs

    4 constdefs: "const" constandefs ";"
    5          | ε

    6 constandefs: constandefs ";" "id" "== or !=" expression
    7            | "id" "== or !=" expression

    8 expression: expression "> or >= or < or <=" expression
    9           | expression "== or !=" expression
   10           | expression "||" expression
   11           | expression "+ or -" expression
   12           | expression "* or / or mod or div or and" expression
   13           | "+ or -" expression
   14           | "!" expression
   15           | variable
   16           | "id" "(" expressions ")"
   17           | "length" "(" expression ")"
   18           | constant
   19           | "(" expression ")"
   20           | listexpression

   21 variable: "id"
   22         | variable "." "id"
   23         | variable "}" expressions "{"
   24         | "list_function" "(" expression ")"

   25 expressions: expressions "," expression
   26            | expression

   27 constant: "iconst"
   28         | "rconst"
   29         | "bconst"
   30         | "cconst"
   31         | "sconst"

   32 listexpression: "}" expressions "{"
   33               | "}" "{"

   34 typedefs: "type" type_defs ";"
   35         | ε

   36 type_defs: type_defs ";" "id" "== or !=" type_def
   37          | "id" "== or !=" type_def

   38 type_def: "array" "}" dims "{" "of" typename
   39         | "list" "of" typename
   40         | "record" fields "end"
   41         | "(" identifiers ")"
   42         | limit ".." limit

   43 dims: dims "," limits
   44     | limits

   45 limits: limit ".." limit
   46       | "id"

   47 limit: "+ or -" "iconst"
   48      | "+ or -" "id"
   49      | "iconst"
   50      | "cconst"
   51      | "bconst"
   52      | "id"

   53 typename: standard_type
   54         | "id"

   55 standard_type: "integer"
   56              | "real"
   57              | "boolean"
   58              | "char"
   59              | "string"

   60 fields: fields ";" field
   61       | field

   62 field: identifiers "[]" typename

   63 identifiers: identifiers "," "id"
   64            | "id"

   65 vardefs: "var" variable_defs ";"
   66        | ε

   67 variable_defs: variable_defs ";" identifiers "[]" typename
   68              | identifiers "[]" typename

   69 subprograms: subprograms subprogram ";"
   70            | ε

   71 subprogram: sub_header ";" "forward"
   72           | sub_header ";" declarations subprograms comp_statement

   73 sub_header: "function" "id" formal_parameters "[]" standard_type
   74           | "procedure" "id" formal_parameters
   75           | "function" "id"

   76 formal_parameters: "(" parameter_list ")"
   77                  | ε

   78 parameter_list: parameter_list ";" pass identifiers "[]" typename
   79               | pass identifiers "[]" typename

   80 pass: "var"
   81     | ε

   82 comp_statement: "begin" statements "end"

   83 statements: statements ";" statement
   84           | statement

   85 statement: assignment
   86          | if_statement
   87          | while_statement
   88          | for_statement
   89          | with_statement
   90          | subprogram_call
   91          | io_statement
   92          | comp_statement
   93          | ε

   94 assignment: variable ":=" expression

   95 if_statement: "if" expression "then" statement if_tail

   96 if_tail: "else" statement
   97        | ε

   98 while_statement: "while" expression "do" statement

   99 for_statement: "for" "id" ":=" iter_space "do" statement
  100              | error "id" ":=" iter_space "do" statement
  101              | "for" error ":=" iter_space "do" statement
  102              | "for" "id" error iter_space "do" statement
  103              | "for" "id" ":=" iter_space error statement

  104 iter_space: expression "to" expression
  105           | expression "downto" expression

  106 with_statement: "with" variable "do" statement

  107 subprogram_call: "id"
  108                | "id" "(" expressions ")"

  109 io_statement: "read" "(" read_list ")"
  110             | "write" "(" write_list ")"
  111             | error "(" write_list ")"
  112             | "write" error write_list ")"
  113             | "write" "(" write_list error

  114 read_list: read_list "," read_item
  115          | read_item

  116 read_item: variable

  117 write_list: write_list "," write_item
  118           | write_item

  119 write_item: expression


